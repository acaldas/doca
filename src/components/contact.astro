---
import { Image } from "astro:assets";
import LogoImage from "../assets/logo_3.svg";
---

<Image
  loading="lazy"
  src={LogoImage}
  alt="Doca - Por mais liberdade"
  class="blur-2xl absolute top-0 bottom-0 right-0 h-full w-auto translate-x-3/4 lg:translate-x-1/2"
/>
<div class="w-full h-full flex-1 flex items-center">
  <div
    class="w-full max-w-2xl pt-6 lg:pt-10 lg:px-6 flex flex-col items-left flex-grow justify-center text-lg relative z-10 text-prose text-left"
  >
    <h3 class="text-green font-semibold text-lg sm:text-xl mb-3">
      Caso pretenda agendar uma consulta:
    </h3>
    <ul class="md:ps-8">
      <li>
        <h4 class="py-4 text-green">
          - de <b>nutrição</b>, envie email para:
          <br />
          <ul class="pl-3 pt-2">
            <li>
              <a href="mailto:info.hbnoad@gmail.com" class="email-link"
                ><u>info.hbnoad@gmail.com</u></a
              >
            </li>
          </ul>
        </h4>
      </li>
      <li>
        <h4 class="py-4 text-green">
          - de <b>psiquiatria, psicoterapia</b> ou <b>psicologia</b>,
          <br />envie email para:
        <ul class="pl-3 pt-2">
          <li>
            <a href="mailto:geral@inesnevescaldas.pt" class="email-link"
              ><u>geral@inesnevescaldas.pt</u></a
            >
          </li>
        </ul>
        </h4>
      </li>
      <li>
        <h4 class="py-4 text-green">
          - de <b>psicologia</b>, envie email para:
          <ul class="pl-3 pt-2">
            <li>
              <a href="mailto:filipa.menano@neuropsyc.pt" class="email-link"
                ><u>filipa.menano@neuropsyc.pt</u></a
              >
            </li>
          </ul>
        </h4>
      </li>
    </ul>
  </div>
</div>

<script>
  const links = document.getElementsByClassName("email-link");
  for (const link of links) {
    link.addEventListener("click", (e) => {
      e.preventDefault();
    });
  }
</script>
